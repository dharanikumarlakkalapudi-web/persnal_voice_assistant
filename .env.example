# Example .env file

# ==========================================
# 1. Groq (Default - Recommended for sub-second latency)
# Get a free API key from https://console.groq.com
# ==========================================
OPENAI_API_KEY="your-groq-api-key-here"
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
MODEL_NAME="llama-3.1-8b-instant"

# ==========================================
# 2. OpenAI (Cloud - Slower)
# ==========================================
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# MODEL_NAME="gpt-4o-mini"

# ==========================================
# 3. Local Model (Ollama)
# ==========================================
# OPENAI_API_KEY="ollama"
# OPENAI_BASE_URL="http://localhost:11434/v1"
# MODEL_NAME="llama3.1"

# ==========================================
# 4. Vision Model (Required for screen analysis)
# ==========================================
VISION_OPENAI_API_KEY="your-openai-api-key-here"
VISION_MODEL_NAME="gpt-4o"
